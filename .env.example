# .env.example: the settings PerioKey reads. Copy this file to .env and fill in only what you need.
# .env is listed in .gitignore, so real keys never go into git. Keep every value here blank.

# Speech-to-text key. Set ONE of these two. Deepgram is used first if both are set.
# Deepgram: make a key at https://console.deepgram.com (Nova-3 streaming).
DEEPGRAM_API_KEY=
# OpenAI: make a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Force a provider when both keys are set: deepgram or openai.
STT_PROVIDER=
# Optional. The OpenAI transcription model. Default: gpt-4o-transcribe
OPENAI_STT_MODEL=
# Optional. OpenAI only: ms of silence that ends a phrase. Default: 300
VAD_SILENCE_MS=

# Optional. OpenAI key only: unclear phrases (one number, chatter, "actually make it 3 3 2")
# go to a small model that drops chatter and applies corrections. off turns it off. Default: on
AI_FILTER=
# Optional. The model for that filter. Default: gpt-5-nano
OPENAI_FILTER_MODEL=

# Which dental software to type into: eaglesoft (default) or generic. One file per choice in profiles/.
PMS_PROFILE=

# practice (default: nothing is typed into other apps) or live (types into the dental software).
PERIOKEY_MODE=

# The start/stop key. F1 to F24. Default: F9. Set a USB foot pedal to send this key.
PERIOKEY_HOTKEY=

# Optional. Part of the window title PerioKey must see before it types, for example Notepad.
# Empty means the profile's own window_match (for Eaglesoft: "Perio Exam").
TARGET_WINDOW=

# Optional. The local port for the PerioKey page. Default: 4317
PORT=
