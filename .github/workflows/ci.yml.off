# The same checks as the merge script, run by GitHub on every pull request. From the starter kit.
# Switched off by its name: GitHub only reads files that end in .yml or .yaml.
# To switch it on, rename it to ci.yml. GitHub Actions minutes may cost money on a private repo.

name: checks

on:
  pull_request:
  push:
    branches: [main]

jobs:
  checks:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      # pnpm/action-setup reads the pnpm version from package.json; a fresh project has none yet.
      - name: Check package.json names the pnpm version
        run: >-
          node -e "if (!require('./package.json').packageManager) { console.error('package.json has no \"packageManager\" field, so CI cannot tell which pnpm to use. Fix: add \"packageManager\": \"pnpm@<version>\" to package.json (pnpm --version prints the version) and commit it.'); process.exit(1); }"
      - uses: pnpm/action-setup@v6
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Install gitleaks
        run: curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz | sudo tar -xz -C /usr/local/bin gitleaks
      - run: node scripts/merge-pr.mjs --check
